# Copy to backend/.env and adjust as needed. All keys are optional; the
# defaults in backend/config.py work for local development out of the box.

# Comma-separated list of allowed frontend origins for CORS.
ATTRITION_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Risk-level thresholds applied to the model-estimated attrition probability.
#   score <  MEDIUM            -> "Low"
#   MEDIUM <= score < HIGH     -> "Medium"
#   score >= HIGH              -> "High"
ATTRITION_RISK_MEDIUM_THRESHOLD=0.35
ATTRITION_RISK_HIGH_THRESHOLD=0.65
